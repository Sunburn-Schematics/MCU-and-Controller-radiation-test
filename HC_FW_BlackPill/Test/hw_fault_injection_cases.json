{
  "suite": "HC manager fault-injection hardware tests",
  "source": "App/ltc3901_manager.c and App/lt8316_manager.c",
  "tests": [
    {
      "id": "fault_setup_disable_periodic_dbg",
      "title": "Disable periodic DBG during fault-injection tests",
      "kind": "setup",
      "request": {
        "type": "SET",
        "msg": 8000,
        "args": {
          "dbg_period_ms": 0,
          "dbg_signals": []
        }
      },
      "expected": {
        "type": "RSP",
        "msg": 8000,
        "args": {
          "dbg_period_ms": 0,
          "dbg_signals": []
        }
      }
    },
    {
      "id": "fault_setup_enable_fast_sts",
      "title": "Enable fast STS observation during manager fault-injection tests",
      "kind": "setup",
      "request": {
        "type": "SET",
        "msg": 8001,
        "args": {
          "sts_period_ms": 250
        }
      },
      "expected": {
        "type": "RSP",
        "msg": 8001,
        "args": {
          "sts_period_ms": 250
        }
      }
    },
    {
      "id": "fault_setup_reset_managers",
      "title": "Reset both DUT managers before fault-injection tests",
      "kind": "setup",
      "request": {
        "type": "SET",
        "msg": 8002,
        "args": {
          "ltc3901_cmd": "RESET",
          "lt8316_cmd": "RESET"
        }
      },
      "expected": {
        "type": "RSP",
        "msg": 8002,
        "args": {
          "ltc3901_cmd": "RESET",
          "lt8316_cmd": "RESET"
        }
      }
    },
    {
      "id": "fault_setup_restore_ltc3901_defaults",
      "title": "Restore LTC3901 manager thresholds before fault-injection tests",
      "kind": "setup",
      "request": {
        "type": "SET",
        "msg": 8003,
        "args": {
          "ltc3901.isupply_ma_max": 50,
          "ltc3901.vupstream_mv_min": 10000,
          "ltc3901.ltc3901_vcc_mv_min": 10000,
          "ltc3901.power_up_timeout_ms": 2000,
          "ltc3901.power_retry_delay_ms": 1000,
          "ltc3901.power_fault_max": 0,
          "ltc3901.sync_on_delay_ms": 3000,
          "ltc3901.sync_hold_on_time_ms": 55000,
          "ltc3901.sync_hold_off_time_ms": 5000,
          "ltc3901.sync_stabilization_time_ms": 100,
          "ltc3901.sync_fault_delay_ms": 1000
        }
      },
      "expected": {
        "type": "RSP",
        "msg": 8003,
        "args": {
          "ltc3901.isupply_ma_max": 50,
          "ltc3901.vupstream_mv_min": 10000,
          "ltc3901.ltc3901_vcc_mv_min": 10000,
          "ltc3901.power_up_timeout_ms": 2000,
          "ltc3901.power_retry_delay_ms": 1000,
          "ltc3901.power_fault_max": 0,
          "ltc3901.sync_on_delay_ms": 3000,
          "ltc3901.sync_hold_on_time_ms": 55000,
          "ltc3901.sync_hold_off_time_ms": 5000,
          "ltc3901.sync_stabilization_time_ms": 100,
          "ltc3901.sync_fault_delay_ms": 1000
        }
      }
    },
    {
      "id": "fault_observe_reset_states",
      "title": "Observe both managers in RESET state",
      "request": {
        "type": "GET",
        "msg": 8010,
        "args": [
          "sw_version"
        ]
      },
      "timeout_seconds": 2,
      "expected_responses": [
        {
          "type": "RSP",
          "msg": 8010
        },
        {
          "type": "STS",
          "duts": {
            "LTC3901": {
              "state": "RESET"
            },
            "LT8316": {
              "state": "RESET"
            }
          }
        }
      ]
    },
    {
      "id": "fault_ltc3901_observe_halt",
      "title": "Drive LTC3901 manager into HALT state",
      "request": {
        "type": "SET",
        "msg": 8011,
        "args": {
          "ltc3901_cmd": "HALT"
        }
      },
      "timeout_seconds": 2,
      "expected_responses": [
        {
          "type": "RSP",
          "msg": 8011,
          "args": {
            "ltc3901_cmd": "HALT"
          }
        },
        {
          "type": "STS",
          "duts": {
            "LTC3901": {
              "state": "HALT"
            }
          }
        }
      ]
    },
    {
      "id": "fault_ltc3901_reset_after_halt",
      "title": "Reset LTC3901 manager after HALT observation",
      "kind": "cleanup",
      "request": {
        "type": "SET",
        "msg": 8012,
        "args": {
          "ltc3901_cmd": "RESET"
        }
      },
      "expected": {
        "type": "RSP",
        "msg": 8012,
        "args": {
          "ltc3901_cmd": "RESET"
        }
      }
    },
    {
      "id": "fault_ltc3901_observe_power_up",
      "title": "Drive LTC3901 manager into POWER_UP state using intentionally unreachable voltage thresholds",
      "request": {
        "type": "SET",
        "msg": 8020,
        "args": {
          "ltc3901.vupstream_mv_min": 500000,
          "ltc3901.ltc3901_vcc_mv_min": 500000,
          "ltc3901.power_up_timeout_ms": 1000,
          "ltc3901.power_retry_delay_ms": 10000,
          "ltc3901.power_fault_max": 1,
          "ltc3901_cmd": "RUN"
        }
      },
      "timeout_seconds": 2,
      "expected_responses": [
        {
          "type": "RSP",
          "msg": 8020
        },
        {
          "type": "EVT",
          "args": {
            "msg": {
              "matches": "^LTC3901: Entering POWER_UP"
            }
          }
        },
        {
          "type": "STS",
          "duts": {
            "LTC3901": {
              "state": "POWER_UP"
            }
          }
        }
      ]
    },
    {
      "id": "fault_ltc3901_reset_after_power_up",
      "title": "Reset LTC3901 manager after POWER_UP observation",
      "kind": "cleanup",
      "request": {
        "type": "SET",
        "msg": 8021,
        "args": {
          "ltc3901_cmd": "RESET"
        }
      },
      "expected": {
        "type": "RSP",
        "msg": 8021,
        "args": {
          "ltc3901_cmd": "RESET"
        }
      }
    },
    {
      "id": "fault_ltc3901_power_up_timeout",
      "title": "Force LTC3901 POWER_FAULT through power-up timeout",
      "request": {
        "type": "SET",
        "msg": 8022,
        "args": {
          "ltc3901.vupstream_mv_min": 500000,
          "ltc3901.ltc3901_vcc_mv_min": 500000,
          "ltc3901.power_up_timeout_ms": 100,
          "ltc3901.power_retry_delay_ms": 10000,
          "ltc3901.power_fault_max": 1,
          "ltc3901_cmd": "RUN"
        }
      },
      "timeout_seconds": 3,
      "expected_responses": [
        {
          "type": "RSP",
          "msg": 8022
        },
        {
          "type": "EVT",
          "args": {
            "msg": {
              "matches": "^LTC3901: Power Up Timeout"
            }
          }
        },
        {
          "type": "STS",
          "duts": {
            "LTC3901": {
              "state": "POWER_FAULT"
            }
          }
        }
      ]
    },
    {
      "id": "fault_ltc3901_reset_after_power_fault_timeout",
      "title": "Reset LTC3901 manager after power-up timeout fault",
      "kind": "cleanup",
      "request": {
        "type": "SET",
        "msg": 8023,
        "args": {
          "ltc3901_cmd": "RESET"
        }
      },
      "expected": {
        "type": "RSP",
        "msg": 8023,
        "args": {
          "ltc3901_cmd": "RESET"
        }
      }
    },
    {
      "id": "fault_ltc3901_observe_powered",
      "title": "Drive LTC3901 manager into POWERED state using permissive thresholds",
      "request": {
        "type": "SET",
        "msg": 8030,
        "args": {
          "ltc3901.isupply_ma_max": 100000,
          "ltc3901.vupstream_mv_min": -1,
          "ltc3901.ltc3901_vcc_mv_min": -1,
          "ltc3901.power_up_timeout_ms": 1000,
          "ltc3901.sync_on_delay_ms": 10000,
          "ltc3901_cmd": "RUN"
        }
      },
      "timeout_seconds": 2,
      "expected_responses": [
        {
          "type": "RSP",
          "msg": 8030
        },
        {
          "type": "EVT",
          "args": {
            "msg": {
              "matches": "^LTC3901: Powered"
            }
          }
        },
        {
          "type": "STS",
          "duts": {
            "LTC3901": {
              "state": "POWERED"
            }
          }
        }
      ]
    },
