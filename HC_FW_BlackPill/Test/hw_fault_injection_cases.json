    {
      "id": "fault_cleanup_run_managers",
      "title": "Confirm both DUT managers can be commanded back into RUN after fault-injection tests",
      "kind": "cleanup",
      "request": {
        "type": "SET",
        "msg": 8093,
        "args": {
          "ltc3901_cmd": "RUN",
          "lt8316_cmd": "RUN"
        }
      },
      "timeout_seconds": 8,
      "expected_responses": [
        {
          "type": "RSP",
          "msg": 8093,
          "args": {
            "ltc3901_cmd": "RUN",
            "lt8316_cmd": "RUN"
          }
        },
        {
          "type": "EVT",
          "args": {
            "msg": {
              "matches": "^LTC3901: Powered"
            }
          }
        },
        {
          "type": "EVT",
          "args": {
            "msg": {
              "matches": "^LT8316: Entering POWERED"
            }
          }
        },
        {
          "type": "STS",
          "duts": {
            "LTC3901": {
              "state": {
                "one_of": [
                  "POWERED",
                  "POWERED_SYNC_ON",
                  "POWERED_SYNC_OFF"
