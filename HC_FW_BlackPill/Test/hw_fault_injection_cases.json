    {
      "id": "fault_ltc3901_sync_fault",
      "title": "Attempt to force LTC3901 POWERED_SYNC_FAULT using zero sync stabilization timing",
      "request": {
        "type": "SET",
        "msg": 8052,
        "args": {
          "ltc3901.isupply_ma_max": 100000,
          "ltc3901.vupstream_mv_min": -1,
          "ltc3901.ltc3901_vcc_mv_min": -1,
          "ltc3901.power_up_timeout_ms": 1000,
          "ltc3901.sync_on_delay_ms": 50,
          "ltc3901.sync_hold_on_time_ms": 100,
          "ltc3901.sync_hold_off_time_ms": 100,
          "ltc3901.sync_stabilization_time_ms": 0,
          "ltc3901.sync_fault_delay_ms": 300,
          "ltc3901_cmd": "RUN"
