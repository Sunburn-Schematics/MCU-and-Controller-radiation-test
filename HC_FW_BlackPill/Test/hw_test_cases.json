{
  "suite": "HC JSON protocol comprehensive tests",
  "source": "Docs/JSON_Tests.md",
  "tests": [
    {
      "id": "setup_disable_periodic_sts",
      "title": "Disable periodic STS during protocol tests",
      "kind": "setup",
      "request": { "type": "SET", "msg": 9000, "args": { "sts_period_ms": 0 } },
      "expected": { "type": "RSP", "msg": 9000, "args": { "sts_period_ms": 0 } }
    },
    {
      "id": "setup_disable_periodic_dbg",
      "title": "Disable periodic DBG during protocol tests",
      "kind": "setup",
      "request": { "type": "SET", "msg": 9001, "args": { "dbg_period_ms": 0, "dbg_signals": [] } },
      "expected": { "type": "RSP", "msg": 9001, "args": { "dbg_period_ms": 0, "dbg_signals": [] } }
    },
    {
      "id": "setup_reset_ltc3901",
      "title": "Reset LTC3901 manager before protocol tests",
      "kind": "setup",
      "request": { "type": "SET", "msg": 9002, "args": { "ltc3901_cmd": "RESET" } },
      "expected": { "type": "RSP", "msg": 9002, "args": { "ltc3901_cmd": "RESET" } }
    },
    {
      "id": "setup_reset_lt8316",
      "title": "Reset LT8316 manager before protocol tests",
      "kind": "setup",
      "request": { "type": "SET", "msg": 9003, "args": { "lt8316_cmd": "RESET" } },
      "expected": { "type": "RSP", "msg": 9003, "args": { "lt8316_cmd": "RESET" } }
    },
    {
      "id": "json_001_set_date_time",
      "title": "Valid SET date_time",
      "source_section": "Docs/JSON_Tests.md example 1",
      "request": { "type": "SET", "msg": 0, "args": { "date_time": "20260501 10:30:00" } },
      "expected": { "type": "RSP", "msg": 0, "ts": "20260501 10:30:00", "args": { "date_time": "20260501 10:30:00" } }
    },
    {
      "id": "json_002_set_date_time_nonzero_msg",
      "title": "Another valid SET date_time",
      "source_section": "Docs/JSON_Tests.md example 2",
      "request": { "type": "SET", "msg": 17, "args": { "date_time": "20261231 23:59:59" } },
      "expected": { "type": "RSP", "msg": 17, "ts": "20261231 23:59:59", "args": { "date_time": "20261231 23:59:59" } }
    },
    {
      "id": "json_003_get_date_time",
      "title": "Valid GET date_time",
      "source_section": "Docs/JSON_Tests.md example 3",
      "request": { "type": "GET", "msg": 1, "args": { "date_time": true } },
      "expected": { "type": "RSP", "msg": 1, "args": { "date_time": { "matches": "^20261231 23:59:[0-5][0-9]$" } } }
    },
    {
      "id": "json_003a_get_sw_version",
      "title": "Valid GET sw_version",
      "source_section": "Docs/JSON_Tests.md example 3a",
      "request": { "type": "GET", "msg": 2, "args": { "sw_version": true } },
      "expected": { "type": "RSP", "msg": 2, "args": { "sw_version": "0.1.1" } }
    },
    {
      "id": "json_004_set_sts_period_ms",
      "title": "Valid SET sts_period_ms",
      "source_section": "Docs/JSON_Tests.md example 4",
      "request": { "type": "SET", "msg": 18, "args": { "sts_period_ms": 250 } },
      "expected": { "type": "RSP", "msg": 18, "args": { "sts_period_ms": 250 } }
    },
    {
      "id": "json_sts_periodic_observe",
      "title": "Observe periodic STS packet",
      "source_section": "Docs/JSON_Tests.md Valid HC periodic STS example",
      "request": { "type": "GET", "msg": 9010, "args": { "sw_version": true } },
      "timeout_seconds": 3,
      "expected_responses": [
        { "type": "RSP", "msg": 9010, "args": { "sw_version": "0.1.1" } },
        { "type": "STS", "hc_id": { "number": true }, "state": { "any": true }, "duts": { "present": true } }
      ]
    },
    {
      "id": "json_005_set_sts_period_ms_disable",
      "title": "Valid SET sts_period_ms disable",
      "source_section": "Docs/JSON_Tests.md example 5",
      "request": { "type": "SET", "msg": 19, "args": { "sts_period_ms": 0 } },
      "expected": { "type": "RSP", "msg": 19, "args": { "sts_period_ms": 0 } }
    },
    {
      "id": "json_006_set_date_time_no_newline",
      "title": "Valid JSON object without trailing newline",
      "source_section": "Docs/JSON_Tests.md example 6",
      "request_raw": "{\"type\":\"SET\",\"msg\":5,\"args\":{\"date_time\":\"20260115 08:45:12\"}}",
      "send_newline": false,
      "expected": { "type": "RSP", "msg": 5, "ts": "20260115 08:45:12", "args": { "date_time": "20260115 08:45:12" } }
    },
    {
      "id": "json_007_set_dbg_config",
      "title": "Valid SET dbg config",
      "source_section": "Docs/JSON_Tests.md example 7",
      "request": { "type": "SET", "msg": 21, "args": { "dbg_period_ms": 100, "dbg_signals": [ "adc.ltc3901_me.raw", "adc.ltc3901_me.mv", "pwm.me.freq_hz", "pwm.me.duty_pct" ] } },
      "expected": { "type": "RSP", "msg": 21, "args": { "dbg_period_ms": 100, "dbg_signals": [ "adc.ltc3901_me.raw", "adc.ltc3901_me.mv", "pwm.me.freq_hz", "pwm.me.duty_pct" ] } }
    },
    {
      "id": "json_008_get_dbg_config",
      "title": "Valid GET dbg config",
      "source_section": "Docs/JSON_Tests.md example 8",
      "request": { "type": "GET", "msg": 22, "args": { "dbg_period_ms": true } },
      "expected": { "type": "RSP", "msg": 22, "args": { "dbg_period_ms": 100, "dbg_signals": [ "adc.ltc3901_me.raw", "adc.ltc3901_me.mv", "pwm.me.freq_hz", "pwm.me.duty_pct" ] } }
    },
    {
      "id": "cleanup_disable_periodic_dbg_after_config",
      "title": "Disable periodic DBG after config tests",
      "kind": "cleanup",
      "request": { "type": "SET", "msg": 9020, "args": { "dbg_period_ms": 0, "dbg_signals": [] } },
      "expected": { "type": "RSP", "msg": 9020, "args": { "dbg_period_ms": 0, "dbg_signals": [] } }
    },
    {
      "id": "json_009_get_dbg_signal_sample",
      "title": "Valid GET dbg signal sample",
      "source_section": "Docs/JSON_Tests.md example 9",
      "request": { "type": "GET", "msg": 23, "args": { "dbg_signals": [ "adc.vupstream.raw", "adc.vupstream.eng" ] } },
      "expected": { "type": "RSP", "msg": 23, "args": { "dbg_signals": { "adc.vupstream.raw": { "nullable_number": true }, "adc.vupstream.eng": { "nullable_number": true } } } }
    },
    {
      "id": "json_010_set_adc_cal",
      "title": "Valid SET adc_cal",
      "source_section": "Docs/JSON_Tests.md example 10",
      "request": { "type": "SET", "msg": 23, "args": { "adc_cal": { "channel": 3, "slope_scaled": 2500, "offset": -100, "valid": true } } },
      "expected": { "type": "RSP", "msg": 23, "args": { "adc_cal": { "channel": 3, "slope_scaled": 2500, "offset": -100, "valid": true } } }
    },
    {
      "id": "json_011_set_digital_signals",
      "title": "Valid SET digital signals",
      "source_section": "Docs/JSON_Tests.md example 11",
      "request": { "type": "SET", "msg": 24, "args": { "dbg_signals": { "ltc3901.pwr_en": true, "lt8316.pwr_en": false, "led.blue": true, "led.red": false, "led.green": true } } },
      "expected": { "type": "RSP", "msg": 24, "args": { "dbg_signals": { "ltc3901.pwr_en": true, "lt8316.pwr_en": false, "led.blue": true, "led.red": false, "led.green": true } } }
    },
    {
      "id": "json_012_set_ltc3901_run",
      "title": "Valid SET LTC3901 command",
      "source_section": "Docs/JSON_Tests.md example 12",
      "request": { "type": "SET", "msg": 27, "args": { "ltc3901_cmd": "RUN" } },
      "expected": { "type": "RSP", "msg": 27, "args": { "ltc3901_cmd": "RUN" } }
    },
    {
      "id": "json_evt_observe_after_ltc3901_run",
      "title": "Observe EVT packet after LTC3901 RUN",
      "source_section": "Docs/JSON_Tests.md Valid HC asynchronous EVT example",
      "request": { "type": "GET", "msg": 9021, "args": { "sw_version": true } },
      "timeout_seconds": 3,
      "expected_responses": [
        { "type": "RSP", "msg": 9021, "args": { "sw_version": "0.1.1" } },
        { "type": "EVT", "hc": { "number": true }, "args": { "msg": { "matches": "^LTC3901:" } } }
      ]
    },
    {
      "id": "cleanup_reset_ltc3901_after_run",
      "title": "Reset LTC3901 manager after RUN test",
      "kind": "cleanup",
      "request": { "type": "SET", "msg": 9022, "args": { "ltc3901_cmd": "RESET" } },
      "expected": { "type": "RSP", "msg": 9022, "args": { "ltc3901_cmd": "RESET" } }
    },
    {
      "id": "json_013_set_lt8316_run",
      "title": "Valid SET LT8316 command",
      "source_section": "Docs/JSON_Tests.md example 13",
      "request": { "type": "SET", "msg": 28, "args": { "lt8316_cmd": "RUN" } },
      "expected": { "type": "RSP", "msg": 28, "args": { "lt8316_cmd": "RUN" } }
    },
    {
      "id": "cleanup_reset_lt8316_after_run",
      "title": "Reset LT8316 manager after RUN test",
      "kind": "cleanup",
      "request": { "type": "SET", "msg": 9023, "args": { "lt8316_cmd": "RESET" } },
      "expected": { "type": "RSP", "msg": 9023, "args": { "lt8316_cmd": "RESET" } }
    },
    {
      "id": "json_014_set_combined_manager_run",
      "title": "Valid combined manager command",
      "source_section": "Docs/JSON_Tests.md example 14",
      "request": { "type": "SET", "msg": 124, "args": { "ltc3901_cmd": "RUN", "lt8316_cmd": "RUN" } },
      "expected": { "type": "RSP", "msg": 124, "args": { "ltc3901_cmd": "RUN", "lt8316_cmd": "RUN" } }
    },
    {
      "id": "cleanup_reset_managers_after_combined_run",
      "title": "Reset managers after combined RUN test",
      "kind": "cleanup",
      "request": { "type": "SET", "msg": 9024, "args": { "ltc3901_cmd": "RESET", "lt8316_cmd": "RESET" } },
      "expected": { "type": "RSP", "msg": 9024, "args": { "ltc3901_cmd": "RESET", "lt8316_cmd": "RESET" } }
    },
    {
      "id": "json_015_get_ltc3901_cfg",
      "title": "Valid GET LTC3901 manager config",
      "source_section": "Docs/JSON_Tests.md example 15",
      "request": { "type": "GET", "msg": 126, "args": { "ltc3901_cfg": true } },
      "expected": { "type": "RSP", "msg": 126, "args": { "ltc3901_cfg": { "isupply_ma_max": { "number": true }, "vupstream_mv_min": { "number": true }, "ltc3901_vcc_mv_min": { "number": true }, "power_up_timeout_ms": { "number": true }, "power_retry_delay_ms": { "number": true }, "power_fault_max": { "number": true }, "sync_on_delay_ms": { "number": true }, "sync_hold_on_time_ms": { "number": true }, "sync_hold_off_time_ms": { "number": true }, "sync_stabilization_time_ms": { "number": true }, "sync_fault_delay_ms": { "number": true } } } }
    },
    {
      "id": "json_016_set_ltc3901_cfg",
      "title": "Valid SET LTC3901 manager config",
      "source_section": "Docs/JSON_Tests.md example 16",
      "request": { "type": "SET", "msg": 127, "args": { "ltc3901_cfg": { "isupply_ma_max": 75, "power_up_timeout_ms": 2500 } } },
      "expected": { "type": "RSP", "msg": 127, "args": { "ltc3901_cfg": { "isupply_ma_max": 75, "power_up_timeout_ms": 2500 } } }
    },
    {
      "id": "json_017_get_lt8316_cfg",
      "title": "Valid GET LT8316 manager config",
      "source_section": "Docs/JSON_Tests.md example 17",
      "request": { "type": "GET", "msg": 128, "args": { "lt8316_cfg": true } },
      "expected": { "type": "RSP", "msg": 128, "args": { "lt8316_cfg": { "power_retry_delay_ms": { "number": true }, "power_fault_max": { "number": true }, "power_on_stabilization_time_ms": { "number": true } } } }
    },
    {
      "id": "json_018_set_lt8316_cfg",
      "title": "Valid SET LT8316 manager config",
      "source_section": "Docs/JSON_Tests.md example 18",
      "request": { "type": "SET", "msg": 129, "args": { "lt8316_cfg": { "power_retry_delay_ms": 1500, "power_fault_max": 4 } } },
      "expected": { "type": "RSP", "msg": 129, "args": { "lt8316_cfg": { "power_retry_delay_ms": 1500, "power_fault_max": 4 } } }
    },
    {
      "id": "json_019_combined_set_command",
      "title": "Valid combined SET command",
      "source_section": "Docs/JSON_Tests.md example 19",
      "request": { "type": "SET", "msg": 125, "args": { "sts_period_ms": 0, "dbg_period_ms": 1000, "ltc3901_cmd": "RUN", "lt8316_cmd": "RUN" } },
      "expected": { "type": "RSP", "msg": 125, "args": { "sts_period_ms": 0, "dbg_period_ms": 1000, "ltc3901_cmd": "RUN", "lt8316_cmd": "RUN" } }
    },
    {
      "id": "cleanup_after_combined_set_command",
      "title": "Reset managers and disable DBG after combined SET command",
      "kind": "cleanup",
      "request": { "type": "SET", "msg": 9025, "args": { "dbg_period_ms": 0, "dbg_signals": [], "ltc3901_cmd": "RESET", "lt8316_cmd": "RESET" } },
      "expected": { "type": "RSP", "msg": 9025, "args": { "dbg_period_ms": 0, "dbg_signals": [], "ltc3901_cmd": "RESET", "lt8316_cmd": "RESET" } }
    },
    {
      "id": "json_020_get_adc_cal",
      "title": "Valid GET adc_cal",
      "source_section": "Docs/JSON_Tests.md example 20",
      "request": { "type": "GET", "msg": 24, "args": { "adc_cal": 3 } },
      "expected": { "type": "RSP", "msg": 24, "args": { "adc_cal": { "channel": 3, "slope_scaled": 2500, "offset": -100, "valid": true } } }
    },
    {
      "id": "json_021_set_adc_cal_channel_name",
      "title": "Valid SET adc_cal with channel name",
      "source_section": "Docs/JSON_Tests.md example 21",
      "request": { "type": "SET", "msg": 25, "args": { "adc_cal": { "channel": "vupstream", "slope_scaled": 2500, "offset": -100, "valid": true } } },
      "expected": { "type": "RSP", "msg": 25, "args": { "adc_cal": { "channel": 0, "slope_scaled": 2500, "offset": -100, "valid": true } } }
    },
    {
      "id": "json_022_get_adc_cal_channel_name",
      "title": "Valid GET adc_cal with channel name",
      "source_section": "Docs/JSON_Tests.md example 22",
      "request": { "type": "GET", "msg": 26, "args": { "adc_cal": "vupstream" } },
      "expected": { "type": "RSP", "msg": 26, "args": { "adc_cal": { "channel": 0, "slope_scaled": 2500, "offset": -100, "valid": true } } }
    },
    {
      "id": "json_023_noise_before_after_object",
      "title": "Valid JSON preceded or followed by non-JSON noise bytes",
      "source_section": "Docs/JSON_Tests.md example 23",
      "request_raw": "junk before{\"type\":\"SET\",\"msg\":9,\"args\":{\"date_time\":\"20260520 14:22:33\"}}junk after",
      "send_newline": false,
      "expected": { "type": "RSP", "msg": 9, "ts": "20260520 14:22:33", "args": { "date_time": "20260520 14:22:33" } }
    },
    {
      "id": "json_024_unsupported_packet_type",
      "title": "Unsupported packet type EXC",
      "source_section": "Docs/JSON_Tests.md example 24",
      "request": { "type": "EXC", "msg": 1, "args": {} },
      "expected": { "type": "RSP", "msg": 1, "error": { "code": "NOT_SUPPORTED" } }
    },
    {
      "id": "json_025_set_missing_supported_field",
      "title": "Missing supported field in SET",
      "source_section": "Docs/JSON_Tests.md example 25",
      "request": { "type": "SET", "msg": 2, "args": {} },
      "expected": { "type": "RSP", "msg": 2, "error": { "code": "BAD_FIELD" } }
    },
    {
      "id": "json_026_set_date_time_wrong_format",
      "title": "args.date_time wrong format in SET",
      "source_section": "Docs/JSON_Tests.md example 26",
      "request": { "type": "SET", "msg": 3, "args": { "date_time": "2026-05-01T10:30:00" } },
      "expected": { "type": "RSP", "msg": 3, "error": { "code": "BAD_VALUE" } }
    },
    {
      "id": "json_027_set_date_time_invalid_calendar",
      "title": "Invalid calendar/time value in SET",
      "source_section": "Docs/JSON_Tests.md example 27",
      "request": { "type": "SET", "msg": 4, "args": { "date_time": "20260230 10:30:00" } },
      "expected": { "type": "RSP", "msg": 4, "error": { "code": "BAD_VALUE" } }
    },
    {
      "id": "json_028_set_sts_period_ms_wrong_type",
      "title": "Invalid args.sts_period_ms type in SET",
      "source_section": "Docs/JSON_Tests.md example 28",
      "request": { "type": "SET", "msg": 20, "args": { "sts_period_ms": true } },
      "expected": { "type": "RSP", "msg": 20, "error": { "code": "BAD_VALUE" } }
    },
    {
      "id": "json_029_get_missing_args",
      "title": "GET missing args",
      "source_section": "Docs/JSON_Tests.md example 29",
      "request": { "type": "GET", "msg": 5 },
      "expected": { "type": "RSP", "msg": 5, "error": { "code": "BAD_ARGS" } }
    },
    {
      "id": "json_030_get_missing_supported_field",
      "title": "GET missing supported field",
      "source_section": "Docs/JSON_Tests.md example 30",
      "request": { "type": "GET", "msg": 6, "args": {} },
      "expected": { "type": "RSP", "msg": 6, "error": { "code": "BAD_FIELD" } }
    },
    {
      "id": "json_031_invalid_set_dbg_period_ms",
      "title": "Invalid SET dbg_period_ms",
      "source_section": "Docs/JSON_Tests.md example 31",
      "request": { "type": "SET", "msg": 23, "args": { "dbg_period_ms": 50 } },
      "expected": { "type": "RSP", "msg": 23, "error": { "code": "BAD_VALUE" } }
    },
    {
      "id": "json_032_invalid_set_dbg_signals",
      "title": "Invalid SET dbg_signals",
      "source_section": "Docs/JSON_Tests.md example 32",
      "request": { "type": "SET", "msg": 24, "args": { "dbg_signals": [ "pwm.me.freq_hz", "not.a.real.signal" ] } },
      "expected": { "type": "RSP", "msg": 24, "error": { "code": "BAD_VALUE" } }
    },
    {
      "id": "json_033_invalid_set_adc_cal",
      "title": "Invalid SET adc_cal",
      "source_section": "Docs/JSON_Tests.md example 33",
      "request": { "type": "SET", "msg": 25, "args": { "adc_cal": { "channel": 99, "slope_scaled": 2500, "offset": 0, "valid": true } } },
      "expected": { "type": "RSP", "msg": 25, "error": { "code": "BAD_VALUE" } }
    },
    {
      "id": "json_034_invalid_get_dbg_signals",
      "title": "Invalid GET dbg_signals",
      "source_section": "Docs/JSON_Tests.md example 34",
      "request": { "type": "GET", "msg": 26, "args": { "dbg_signals": [ "adc.vupstream.raw", "not.a.real.signal" ] } },
      "expected": { "type": "RSP", "msg": 26, "error": { "code": "BAD_VALUE" } }
    },
    {
      "id": "json_035_get_date_time_not_true",
      "title": "GET args.date_time not true",
      "source_section": "Docs/JSON_Tests.md example 35",
      "request": { "type": "GET", "msg": 7, "args": { "date_time": false } },
      "expected": { "type": "RSP", "msg": 7, "error": { "code": "BAD_VALUE" } }
    },
    {
      "id": "json_036_non_numeric_msg",
      "title": "Non-numeric msg",
      "source_section": "Docs/JSON_Tests.md example 36",
      "request_raw": "{\"type\":\"SET\",\"msg\":\"abc\",\"args\":{\"date_time\":\"20260501 10:30:00\"}}",
      "expected": { "type": "RSP", "error": { "code": "BAD_ARGS" } }
    },
    {
      "id": "json_037_missing_closing_brace",
      "title": "Missing closing brace",
      "source_section": "Docs/JSON_Tests.md example 37",
      "request_raw": "{\"type\":\"SET\",\"msg\":8,\"args\":{\"date_time\":\"20260501 10:30:00\"}",
      "send_newline": false,
      "timeout_seconds": 1,
      "expect_no_response": true,
      "cleanup_raw": "}"
    },
    {
      "id": "json_038_extra_closing_brace",
      "title": "Extra closing brace",
      "source_section": "Docs/JSON_Tests.md example 38",
      "request_raw": "{\"type\":\"SET\",\"msg\":9,\"args\":{\"date_time\":\"20260501 10:30:00\"}}}",
      "send_newline": false,
      "expected": { "type": "RSP", "msg": 9, "ts": "20260501 10:30:00", "args": { "date_time": "20260501 10:30:00" } }
    },
    {
      "id": "json_039_unquoted_key",
      "title": "Unquoted key",
      "source_section": "Docs/JSON_Tests.md example 39",
      "request_raw": "{type:\"SET\",\"msg\":10,\"args\":{\"date_time\":\"20260501 10:30:00\"}}",
      "expected": { "type": "RSP", "error": { "code": "BAD_JSON" } }
    },
    {
      "id": "json_040_unterminated_string",
      "title": "Unterminated string",
      "source_section": "Docs/JSON_Tests.md example 40",
      "request_raw": "{\"type\":\"SET\",\"msg\":11,\"args\":{\"date_time\":\"20260501 10:30:00}}",
      "send_newline": false,
      "timeout_seconds": 1,
      "expect_no_response": true,
      "cleanup_raw": "\"}}"
    },
    {
      "id": "json_041_top_level_array",
      "title": "Top-level array instead of object",
      "source_section": "Docs/JSON_Tests.md example 41",
      "request_raw": "[{\"type\":\"SET\",\"msg\":12,\"args\":{\"date_time\":\"20260501 10:30:00\"}}]",
      "send_newline": false,
      "expected": { "type": "RSP", "msg": 12, "ts": "20260501 10:30:00", "args": { "date_time": "20260501 10:30:00" } }
    },
    {
      "id": "json_042_oversized_json_object",
      "title": "Oversized JSON object",
      "source_section": "Docs/JSON_Tests.md example 42",
